{
  "name": "@vanguard/proto",
  "version": "1.0.0",
  "description": "Protocol buffer definitions and generated TypeScript types/clients for Vanguard services.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "proto:generate": "node scripts/generate.js",
    "proto:generate:watch": "nodemon --watch src --ext proto --exec 'pnpm proto:generate'"
  },
  "keywords": [
    "protobuf",
    "proto",
    "protocol-buffers",
    "typescript",
    "grpc",
    "nestjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.13.3",
    "@nestjs/microservices": "^11.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "grpc-tools": "^1.12.4",
    "rimraf": "^5.0.0",
    "ts-proto": "^1.181.2",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@nestjs/microservices": "^11.0.1",
    "rxjs": "^7.8.1"
  }
}
